# ScoopScope Root Environment Configuration Example
#
# For local Python/FastAPI execution, copy this file to backend/.env
# and configure your API keys.
# Never commit real keys or .env files to version control.

# --- Required credentials ---
# Google Gemini API Key from Google AI Studio: https://aistudio.google.dev/apikey
GEMINI_API_KEY=

# Serper Google Search API Key from Serper: https://serper.dev
SERPER_API_KEY=

# --- Optional overrides & defaults ---
GEMINI_MODEL=gemini-flash-lite-latest
MAX_INPUT_CHARS=10000
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
RESEARCH_TIMEOUT_SECONDS=90
